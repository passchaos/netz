{
  "schema": 1,
  "date": "2026-11-01",
  "feature": "transactional SharedChannel live service-config and endpoint updates",
  "decision": "accepted transactional live-update API",
  "public_api": [
    "SharedChannel.update",
    "SharedChannel.updateWithTimeout",
    "SharedChannel.updateWithDeadline",
    "SharedChannel.configurationRevision",
    "grpc.SharedChannelUpdate"
  ],
  "contracts": [
    "service config and canonical endpoint replacement publish in one State transaction",
    "method policy readers retain one immutable generation across concurrent publication",
    "unchanged sources and physical connections survive updates and source reorder",
    "retired sources leave new admission while active unary and duplex work finishes",
    "all fallible allocations and candidate task admission precede publication; failed candidates are canceled behind activation gates",
    "original caller deadline and cancellation are checked again after candidate task admission",
    "Health and ORCA settings are owned by the endpoint task across control-stream restart",
    "explicit selection policy governs the actual picker during construction and updates",
    "identical config and endpoint-only updates preserve healthy pick-first selection and child runtime state",
    "an empty resolved update disables new admission without canceling active work"
  ],
  "regressions": {
    "method_policy": "new request-size policy applies through a retained Sender while an old request and old config arena remain valid",
    "source_retirement": "new RPC reaches replacement endpoint while removed endpoint completes its old RPC",
    "duplex_retirement": "request DATA and response DATA both follow removal; old owner closes before the new channel is destroyed",
    "health": "changed service gates new RPCs until SERVING, old RPC completes, clearing checking reuses the same connection",
    "canonical_inventory": "ring-to-RR-to-ring rebuild keeps complete configured endpoints and retained source identities",
    "recursive_policy": "weighted ring, WRR and outlier replacement initializes matching child-local storage",
    "allocation_failure": "checkAllAllocationFailures covers construction and update while checking published snapshot rollback",
    "task_capacity": "failure before and after partial candidate task admission preserves revision and endpoint set",
    "late_deadline": "a 250 ms successful task admission under a 200 ms caller budget returns Timeout and preserves revision 1; pre-fix test observed revision 2 instead",
    "reader_publication": "reader-start synchronization guarantees an actual retained configuration before 30 alternating updates",
    "selection_override": "two real endpoints remain round-robin despite JSON weighted-target pick-first children, before and after update",
    "pick_first_stability": "failed primary recovers, identical publication and endpoint reorder retain the selected healthy sibling",
    "invalid_topology": "custom ring without key and weighted-target selection without a policy tree fail before publication"
  },
  "results": {
