    "public_package": "26/26 passed",
    "synchronized_reader_debug": "144/144 passed",
    "synchronized_reader_release_fast": "144/144 passed",
    "interop": "21 matrix rows passed; three shared_update modes each complete two RPCs on one retained connection and retire all native sockets"
