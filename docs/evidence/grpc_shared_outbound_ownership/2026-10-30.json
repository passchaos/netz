  "measured_problem": {
    "path": "Shared stream Writer.submit -> Write.create -> ClientDuplex.stageMessage -> encodeMessageAlloc",
    "before": "Write.create cloned the caller payload into one command allocation. stageMessage then grew another 5+payload framed buffer, copied the full payload again, and immediately freed the command allocation.",
    "grpc_core_reference": "grpc-core adds a tiny five-byte header slice and references the Message SliceBuffer payload from grpc_chttp2 send_message_locked without flattening it."
  },
  "design": {
    "module": "src/grpc/stream/duplex/outbound_ownership.zig",
    "references": [
      "/nav_env/Work/grpc/src/core/call/message.h",
      "/nav_env/Work/grpc/src/core/ext/transport/chttp2/transport/chttp2_transport.cc"
    ],
    "description": "Write.create now allocates one 5+payload command buffer, leaves five prefix bytes reserved, and clones the borrowed caller payload directly behind them. ClientDuplex.stageOwnedMessageStorage validates the wire length, writes the prefix in place, and transfers that exact allocation into PendingMessage for identity or compression fallback.",
    "compressed_path": "When gzip/deflate actually reduces the payload, the compressor and framed compressed output retain the previous separate-allocation path; after successful staging the command frees its original input allocation.",
    "packetization": "PendingMessage remains one contiguous slice, so HTTP/2 DATA frame boundaries and write/flow-control behavior do not change.",
    "finish_only": "Finish-only commands retain an empty allocation and do not reserve unused prefix storage.",
    "failure_contract": "Before successful staging the command retains storage. Length validation, compression, or framed-output OOM leaves it owned by the command. On an input_transferred=true result the command detaches storage exactly once; otherwise it frees the input after the stream owns the compressed output.",
    "tests": [
      "identity storage prepends the prefix under an allocator that rejects every allocation",
      "compressed output keeps caller input ownership and round-trips through strict gzip",
      "every compressed staging allocation-failure boundary is leak-free",
      "shared write command transfers prefix-reserved storage exactly once",
      "interrupted operation retains the original command payload"
    ]
  },
