diff --git a/src/mqtt/session/outgoing_ack.zig b/src/mqtt/session/outgoing_ack.zig
new file mode 100644
index 00000000..677313bb
--- /dev/null
+++ b/src/mqtt/session/outgoing_ack.zig
@@ -0,0 +1,63 @@
+//! Validate and apply one outgoing QoS transaction before observing its state.
+const std = @import("std");
+const mqtt = @import("../mod.zig");
+
+pub fn apply(
+    comptime Context: type,
+    store: *Context.StoreType,
+    session: *Context.SessionType,
+    packet_type: mqtt.PacketType,
+    packet_id: u16,
+    reason_code: u8,
+) Context.ErrorType!Context.AckActionType {
+    const index = session.packet_index.get(packet_id) orelse
+        return error.InvalidAcknowledgement;
+    const inflight = &session.inflight.items[index];
+    std.debug.assert(inflight.packet_id != 0);
+    switch (packet_type) {
+        .puback, .pubrec, .pubcomp => try mqtt.validateAckReasonCode(packet_type, reason_code),
+        else => return error.InvalidAcknowledgement,
+    }
+    switch (packet_type) {
+        .puback => {
+            if (inflight.state != .await_puback) {
+                return error.InvalidAcknowledgement;
+            }
+            Context.removeInflight(store, session, index);
+            return .completed;
+        },
+        .pubrec => {
+            if (inflight.state == .await_pubcomp) {
+                // A repeated successful PUBREC requests retransmission of
+                // the PUBREL already emitted for this transaction. Keep
+                // the durable stage and make the control packet eligible
+                // for the connection writer again.
+                if (reason_code >= 0x80) {
+                    return error.InvalidAcknowledgement;
+                }
+                Context.noteNeedsSend(session, index, inflight);
+                inflight.retransmission = true;
+                return .send_pubrel;
+            }
+            if (inflight.state != .await_pubrec) {
+                return error.InvalidAcknowledgement;
+            }
+            if (reason_code >= 0x80) {
+                Context.removeInflight(store, session, index);
+                return .completed;
+            }
+            Context.noteNeedsSend(session, index, inflight);
+            inflight.state = .await_pubcomp;
+            inflight.retransmission = false;
+            return .send_pubrel;
+        },
+        .pubcomp => {
+            if (inflight.state != .await_pubcomp) {
+                return error.InvalidAcknowledgement;
+            }
+            Context.removeInflight(store, session, index);
+            return .completed;
+        },
+        else => return error.InvalidAcknowledgement,
+    }
+}
diff --git a/src/mqtt/session/outgoing_status.zig b/src/mqtt/session/outgoing_status.zig
