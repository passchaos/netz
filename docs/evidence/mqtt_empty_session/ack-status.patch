--- /dev/null
+++ b/src/mqtt/broker/session_writer/ack_flush_tests.zig
@@ -0,0 +1,72 @@
+const std = @import("std");
+const mqtt = @import("../../mod.zig");
+const session = @import("../../session/mod.zig");
+
+pub fn terminalAck(comptime Context: type) !void {
+    const allocator = std.testing.allocator;
+    var threaded = std.Io.Threaded.init(allocator, .{});
+    defer threaded.deinit();
+    const io = threaded.io();
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const Backend = enum { memory, autosave, commit_log };
+    for ([_]Backend{ .memory, .autosave, .commit_log }) |backend| {
+        var broker = try Context.BrokerType.init(allocator, io, .{
+            .limits = .{ .max_connections = 1 },
+            .persistent_change_autosave = if (backend == .autosave) .{
+                .dir = tmp.dir,
+                .sub_path = "ack.db",
+                .max_changes = 1,
+            } else null,
+        });
+        defer broker.deinit();
+        if (backend == .commit_log) try broker.createCommitLog(tmp.dir, "ack.log", .{});
+        const opened = try broker.sessions.open("ack-flush", false, 60, .zero);
+        const slot = &broker.slots[0];
+        slot.state.has_session_handle = true;
+        slot.session_handle_value = opened.handle;
+        slot.state.session_persistent = true;
+        _ = try broker.sessions.enqueuePublish(opened.handle, "ack/topic", "payload", .{
+            .qos = .at_least_once,
+            .now = .zero,
+        });
+        var output: [1]session.Transmission = undefined;
+        const packet_id = (try broker.sessions.drainInto(opened.handle, .zero, 1, &output))[0].publish.packet_id;
+        var task_result: ?anyerror = null;
+        // The ACK helper uses only broker and the supplied slot; CONNECT
+        // ownership belongs to the surrounding client lifecycle.
+        const task = Context.TaskType{
+            .broker = &broker,
+            .slot_index = 0,
+            .subscriber_id = 0,
+            .connect = undefined,
+            .result = &task_result,
+        };
+        slot.writer_mutex.lockUncancelable(io);
+        var writer_owned = true;
+        defer if (writer_owned) slot.writer_mutex.unlock(io);
+        broker.state_mutex.lockUncancelable(io);
+        var state_owned = true;
+        defer if (state_owned) broker.state_mutex.unlock(io);
+        const ack = try Context.ack(&broker, slot, mqtt.AckPacket{
+            .packet_type = .puback,
+            .packet_id = packet_id,
+        });
+        try std.testing.expect(ack.owned);
+        try std.testing.expect(ack.persistent_changed);
+        try std.testing.expect(!ack.has_outgoing_work);
+        const coalesced = try Context.flush(task, slot, ack);
+        writer_owned = !coalesced;
+        state_owned = !coalesced;
+        try std.testing.expectEqual(backend == .memory, coalesced);
+        // The memory path consumes both locks. A live persistence backend
+        // leaves both with its caller until the ACK durability barrier.
+        const state_available = broker.state_mutex.tryLock();
+        if (state_available) broker.state_mutex.unlock(io);
+        try std.testing.expectEqual(coalesced, state_available);
+        const writer_available = slot.writer_mutex.tryLock();
+        if (writer_available) slot.writer_mutex.unlock(io);
+        try std.testing.expectEqual(coalesced, writer_available);
+        try std.testing.expectEqual(@as(usize, 0), (try broker.sessions.stats(opened.handle)).inflight_count);
+    }
+}
