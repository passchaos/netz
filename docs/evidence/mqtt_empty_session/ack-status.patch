+        const repeated = try store.handleAckWithOutgoingWork(opened.handle, .pubrec, id, 0);
+        try std.testing.expect(repeated.has_outgoing_work);
+        try std.testing.expectEqual(session.AckAction.send_pubrel, repeated.action);
+        const release = try store.drainInto(opened.handle, .zero, 1, &storage);
+        try std.testing.expect(release[0] == .pubrel);
+        try std.testing.expectEqual(id, release[0].pubrel.packet_id);
+        const complete = try store.handleAckWithOutgoingWork(opened.handle, .pubcomp, id, 0);
+        try std.testing.expect(!complete.has_outgoing_work);
+    }
+}
