diff --git a/src/mqtt/session/outgoing_status.zig b/src/mqtt/session/outgoing_status.zig
new file mode 100644
index 00000000..483ca4c9
--- /dev/null
+++ b/src/mqtt/session/outgoing_status.zig
@@ -0,0 +1,12 @@
+//! Separate selectable output from transactions that still require maintenance.
+
+pub fn hasUnselected(session: anytype, no_send: u16) bool {
+    return session.next_inflight_send != no_send or session.queued_count != 0;
+}
+
+/// Sent inflight entries still require expiry/ACK handling, and detached
+/// QoS 0 still belongs to its current writer. Neither is an idle Session.
+pub fn hasWork(session: anytype) bool {
+    return session.queued_count != 0 or session.inflight_count != 0 or
+        session.pending_qos0 != null;
+}
diff --git a/src/mqtt/session/outgoing_status_tests.zig b/src/mqtt/session/outgoing_status_tests.zig
new file mode 100644
index 00000000..023a8a7e
--- /dev/null
+++ b/src/mqtt/session/outgoing_status_tests.zig
@@ -0,0 +1,68 @@
+const std = @import("std");
+const mqtt = @import("../mod.zig");
+const session = @import("mod.zig");
+const allocator = std.testing.allocator;
+
+test "session outgoing work distinguishes idle and sent QoS1 transactions" {
+    var store = session.Store.init(allocator, .{});
+    defer store.deinit();
+    const opened = try store.open("work-qos1", false, 60, .zero);
+    try std.testing.expect(!try store.hasOutgoingWork(opened.handle));
+    _ = try store.enqueuePublish(opened.handle, "work/topic", "payload", .{ .qos = .at_least_once, .now = .zero });
+    try std.testing.expect(try store.hasOutgoingWork(opened.handle));
+    var storage: [1]session.Transmission = undefined;
+    const transmissions = try store.drainInto(opened.handle, .zero, 1, &storage);
+    try std.testing.expectEqual(@as(usize, 1), transmissions.len);
+    try std.testing.expect(!try store.hasUnselectedTransmission(opened.handle));
+    try std.testing.expect(try store.hasOutgoingWork(opened.handle));
+    _ = try store.handleAck(opened.handle, .puback, transmissions[0].publish.packet_id, 0);
+    try std.testing.expect(!try store.hasOutgoingWork(opened.handle));
+}
+
+test "session outgoing work retains QoS2 through PUBREL and final PUBCOMP" {
+    var store = session.Store.init(allocator, .{});
+    defer store.deinit();
+    const opened = try store.open("work-qos2", false, 60, .zero);
+    _ = try store.enqueuePublish(opened.handle, "work/topic", "payload", .{ .qos = .exactly_once, .now = .zero });
+    var storage: [1]session.Transmission = undefined;
+    const sent = try store.drainInto(opened.handle, .zero, 1, &storage);
+    const id = sent[0].publish.packet_id;
+    _ = try store.handleAck(opened.handle, .pubrec, id, 0);
+    try std.testing.expect(try store.hasUnselectedTransmission(opened.handle));
+    try std.testing.expect(try store.hasOutgoingWork(opened.handle));
+    const release = try store.drainInto(opened.handle, .zero, 1, &storage);
+    try std.testing.expect(release[0] == .pubrel);
+    try std.testing.expect(!try store.hasUnselectedTransmission(opened.handle));
+    try std.testing.expect(try store.hasOutgoingWork(opened.handle));
+    _ = try store.handleAck(opened.handle, .pubcomp, id, 0);
+    try std.testing.expect(!try store.hasOutgoingWork(opened.handle));
+}
+
+test "session outgoing work retains a detached QoS0 packet until writer commit" {
+    var store = session.Store.init(allocator, .{});
+    defer store.deinit();
+    const opened = try store.open("work-qos0", false, 60, .zero);
+    _ = try store.enqueuePublish(opened.handle, "work/topic", "payload", .{ .qos = .at_most_once, .now = .zero });
+    var storage: [1]session.Transmission = undefined;
+    const sent = try store.drainInto(opened.handle, .zero, 1, &storage);
+    try std.testing.expectEqual(@as(usize, 0), sent[0].publish.packet_id);
+    try std.testing.expect(!try store.hasUnselectedTransmission(opened.handle));
+    try std.testing.expect(try store.hasOutgoingWork(opened.handle));
+    try std.testing.expectError(error.InflightFull, store.drainInto(opened.handle, .zero, 1, &storage));
+    try store.completeQoS0Transmission(opened.handle, try store.routeId(opened.handle), 0);
+    try std.testing.expect(!try store.hasOutgoingWork(opened.handle));
+}
+
+test "session outgoing work preserves expiry maintenance for sent and queued messages" {
+    var store = session.Store.init(allocator, .{});
+    defer store.deinit();
+    const opened = try store.open("work-expiry", false, 60, .zero);
+    const properties = [_]mqtt.Property{.{ .four_byte = .{ .id = .message_expiry_interval, .value = 1 } }};
+    _ = try store.enqueuePublish(opened.handle, "work/topic", "sent", .{ .qos = .at_least_once, .properties = &properties, .now = .zero });
+    var storage: [1]session.Transmission = undefined;
+    _ = try store.drainInto(opened.handle, .zero, 1, &storage);
+    _ = try store.enqueuePublish(opened.handle, "work/topic", "queued", .{ .qos = .at_least_once, .properties = &properties, .now = .zero });
+    try std.testing.expect(try store.hasOutgoingWork(opened.handle));
+    try std.testing.expectEqual(@as(usize, 0), (try store.drainInto(opened.handle, .fromNanoseconds(2 * std.time.ns_per_s), 1, &storage)).len);
+    try std.testing.expect(!try store.hasOutgoingWork(opened.handle));
+}
