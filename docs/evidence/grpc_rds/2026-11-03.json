{
  "schema": 1,
  "date": "2026-11-03",
  "feature": "Typed RDS and immutable per-RPC route/cluster/hash/timeout/retry selection",
  "decision": "accepted",
  "base_head": "8b7f2468acabfd22e4297adf436c40fe79cd784d",
  "behavior": {
    "routing": "owned v3 RouteConfiguration, exact/suffix/prefix/universe authority precedence, ordered path/header/fraction matching; single/weighted cluster keys map to existing cluster manager children; choice fixed per RPC",
    "hash": "joined visible header XXH64 and stable channel-ID, rotate/XOR combination and terminal rules, random fallback, binary headers absent; unknown cookie/connection/query sources ignored like grpc-core",
    "timeout_retry": "original call entry includes selection; cancellation/deadline enforced during regex evaluation; route grpc_timeout_header_max preference/zero disable; inherited or explicit retry disable, grpc-core defaults/status codes, five-attempt clamp and service-config retry throttle",
    "generations": "immutable selector owner retained per config epoch; parsed config storage is shared without generation chains; worker LB/health/ORCA sees same config storage for route-only updates and preserves transports",
    "validation": "required cluster keys validated against same prepared topology; bounded bytes/counts/total clusters/regex/storage; sorted duplicate/key detection; constructor and update rollback preserve topology/version",
    "ads": "validate all resources and duplicate names before selector publication; omission installs rejecting empty selector; accept applied version before ACK output; stale tokens and invalid/failed publication preserve prior state",
    "errors": "unary missing/inappropriate route returns local UNAVAILABLE with no transport and no EDS drop marker; streaming returns pre-wire typed error; canceled/expired/closed admission remains authoritative",
    "open_scope": "uses application-provided cluster manager topology; LDS/HCM/bootstrap and automatic multi-cluster CDS/EDS, expiry/failover/Delta/LRS, filters, hash capture/substitution and rewriting remain open"
  },
