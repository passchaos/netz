{
  "schema": 1,
  "date": "2026-11-01",
  "feature": "deactivated weighted-target child retention and reactivation",
  "decision": "accepted production lifecycle feature",
  "defaults": {
    "removed_child_retention_seconds": 900,
    "max_retained_children": 256
  },
  "public_options": [
    "removed_child_retention",
    "max_retained_children"
  ],
  "public_status": "SharedChannel.retainedChildCount",
  "contracts": [
    "retained child pins its policy subtree and old parsed arena independently of active publication",
    "deactivated source is excluded from application admission and aggregate READY but keeps transport and control ownership",
    "reactivation before expiration reuses matching source owners and restores compatible policy/outlier state",
    "cached source lookup preserves distinct duplicate resolver owners",
    "old active RPC completion and ORCA reports continue while child is inactive",
    "background timer expires unused child without application polling and retires quiescent connections",
    "repeated deactivation does not renew expiration; nested reactivation can retain removed descendants separately",
    "zero retention disables caching; capacity, allocation and manager admission failures preserve old publication",
    "caller deadline checked after staged manager start aborts manager before cache publication",
    "channel destruction joins manager and endpoint owners and stops retained resolver callbacks"
  ],
  "results": {
    "complete_grpc_debug": "540/540 passed",
    "retention_release_fast": "156/156 passed",
    "public_package": "26/26 passed",
    "interop": "24 matrix rows passed; h2c/TLS 1.2/TLS 1.3 retained-child A/B/A routing used two physical connections with per-session request counts 2 and 1"
  },
  "regressions": {
    "default": "test confirms the default 900-second configured duration",
    "reactivation": "A source removed from current inventory returns through its original connection; inactive phase routes only to B",
    "expiry": "100-ms retained child closes old transport and publishes shutdown without application polling; returning child uses fresh connection",
    "completion": "active UNAVAILABLE completes while inactive and its failure bucket survives reactivation",
    "orca": "inactive original OOB stream delivers an updated report; reactivation accepts business RPC without opening a second control stream",
    "nested": "reactivated parent restores active descendant while another descendant retains its own independent entry",
    "capacity": "full cache rejects next removal and preserves first child expiration",
    "allocation": "checkAllAllocationFailures covers cache preparation and published revision rollback",
    "deadline": "successful 250-ms manager admission under 200-ms caller deadline returns Timeout with no published manager/cache",
    "empty_map": "all cached READY endpoints remain excluded and aggregate becomes TRANSIENT_FAILURE",
    "duplicates": "two duplicate RR inputs restore two original owners and preserve per-connection response order",
    "disabled": "zero duration retires immediately without needing the additional manager concurrency slot"
  },
