{
  "schema": 1,
  "date": "2026-10-30",
  "feature": "SharedChannel explicit owned outbound messages",
  "decision": "accepted",
  "scope": {
    "baseline_commit": "760434cd13f114bf6de5e471be5998f042c8fbd3",
    "language_surface": "pure Zig",
    "borrowed_api_changed": false
  },
  "design": {
    "public_type": "grpc.SharedStreamOwnedWriteMessage",
    "entry_points": [
      "SharedStreamWriter.allocMessage",
      "SharedStreamWriter.writeOwnedMessage",
      "SharedStreamWriter.writeOwnedMessageWithOptions",
      "SharedStreamWriter.writeOwnedMessageWithDeadline",
      "SharedStreamWriter.writeOwnedMessageWithOptionsAndDeadline",
      "SharedStreamWriter.writeOwnedMessageWithTimeout",
      "SharedStreamWriter.writeFinalOwnedMessage",
      "SharedStreamWriter.writeFinalOwnedMessageWithOptions",
      "SharedStreamWriter.writeFinalOwnedMessageWithDeadline"
    ],
    "description": "allocMessage reserves five prefix bytes in the SharedChannel allocator and exposes only the writable payload. Submission transfers the exact allocation into the existing prefix-reserved endpoint staging path.",
    "consumption_contract": "Every owned write consumes the nullable message on success or error. A deferred deinit is safe because successful or failed submission clears/frees storage exactly once.",
    "compression_contract": "Identity and compression fallback preserve the allocation pointer through PendingMessage. Successful compression releases the input only after the separate compressed frame is owned.",
    "failure_contract": "Invalid deadline consumes locally before publication; allocator mismatch leaves storage owned until submitOwned's single deferred cleanup; command OOM retains the message until the same cleanup; timeout after publication follows the existing command abandonment and call cancellation contract."
  },
  "deterministic_allocation_evidence": {
    "payload_bytes": 25,
    "borrowed": {
      "allocations": 3,
      "components": [
        "caller serialized payload",
        "Write command",
        "queued prefix-reserved clone"
      ]
    },
    "owned": {
      "allocations": 2,
      "components": [
        "prefix-reserved serialized payload",
        "Write command"
      ]
    },
    "removed_allocations": 1,
    "removed_requested_bytes": 25,
    "pointer_identity": "Write.createOwned command storage pointer equals OwnedWriteMessage storage pointer"
  },
  "tests": [
    "owned command pointer transfer without copying",
    "foreign allocator rejection retains ownership transactionally",
    "all message and command allocation-failure boundaries",
    "deterministic three-versus-two allocation comparison",
    "invalid deadline consumes before publication",
    "real gzip owned message",
    "real identity compression-opt-out owned message",
    "real final owned message"
  ],
