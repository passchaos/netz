  "feature": "xDS v3 state-of-the-world ADS transport and accepted-version state",
  "decision": "accepted",
  "base_head": "48220834acfbba07a6600699bb106aa4adb6f175",
  "behavior": {
    "wire": "standard v3 DiscoveryRequest/DiscoveryResponse envelopes, opaque Any resources, protobuf singular-last semantics and unknown-field skipping",
    "node": "owned first-request Node id/cluster/locality/user-agent/client-features and serialized Struct metadata; later requests omit Node",
    "subscriptions": "copied sorted unique resource names with explicit wildcard list, bounded type/name storage and deferred per-type writes while a response awaits decision",
    "versions": "ACK advances accepted version; NACK retains previous accepted version and sends non-OK google.rpc.Status with current nonce",
    "tokens": "stable client identity, stream epoch and response sequence prevent cross-client, stale-stream and superseded same-type decisions",
    "replay": "stream terminal or write ambiguity clears old nonces/NACKs, preserves desired names/applied versions and explicit reconnect replays them",
    "ack_allocation": "an applied ACK remains dirty with its accepted version when encoding allocation fails; later flush sends it successfully",
    "deadlines": "one connect budget covers stream queue/HEADERS admission and subscription replay, separate from optional whole-RPC lifetime; local read timeout/cancellation/executor interruption preserves a live stream",
    "bounds": "explicit envelope/resource bytes/count and subscription-type/name bounds; malformed envelopes and unexpected resource types retire the current stream while resource-type mismatch remains available for NACK",
    "structure": "cohesive ADS codec, subscription and client modules with nearby pure and real-duplex tests"
  },
