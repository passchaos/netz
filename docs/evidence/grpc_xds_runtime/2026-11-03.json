  "behavior": {
    "chain": "rejecting empty start, listener/RDS cluster references generate CDS and service subscriptions; EDS-backed CDS policies/circuit and EDS targets/drops form retained manager children without manually configured endpoints",
    "pending_removal": "initial missing CDS/EDS queues fail-fast requests; valid omission removes resource; EDS-name changes remove prior endpoints and await matching service data; duplicate/unsupported resource validation preserves accepted state",
    "staging": "immutable identity/CDS/projected EDS references cloned into plans; all name sets allocated and type capacity reserved in a batch before one target/config/selector transaction; commit names/caches before version and ACK output",
    "lifetime": "retained target inventory owns prefixed paths and EDS references; projection epochs retain dependencies while old config/call references remain; synchronize/later updates prune unused cache",
    "budgets": "cluster/projection and unique route+CDS+EDS+target storage bounds, start/admission deadline priority, local non-LB configuration preserved and channel/cluster admission composed",
    "open": "application drives serialized ADS/reconnect/synchronization; bootstrap, automatic retry/failover/expiry/Delta/LRS and aggregate/DNS/security/filter/rewrite features remain open"
  },
