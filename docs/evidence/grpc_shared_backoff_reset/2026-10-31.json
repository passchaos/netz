{
  "schema": 1,
  "date": "2026-10-31",
  "feature": "SharedChannel explicit connection and resolver backoff reset",
  "decision": "accepted production recovery API",
  "public_api": [
    "resetConnectionBackoff",
    "resetConnectionBackoffWithDeadline",
    "resetConnectionBackoffWithTimeout"
  ],
  "contracts": [
    "State admission posts coalesced commands; endpoint and resolver owners mutate their own retry state",
    "an explicit reset bypasses the scheduled connection retry and DNS refresh throttle",
    "healthy transports retain their connection and all active RPCs",
    "an in-progress connect retains its original attempt deadline and is not duplicated",
    "idle reset creates no connection demand",
    "closed, expired and canceled admission fails before command publication"
  ],
  "regressions": {
    "retry_delay_seconds": 60,
    "failed_endpoint": "one refused attempt, explicit reset, one successful connect and RPC while a healthy sibling retains one physical connection",
    "dns_failure": "one failed lookup, explicit reset, second lookup succeeds despite 60-second backoff and refresh minimum",
    "in_progress_attempt": "reset leaves the gated first attempt active, then immediately retries after its refusal",
    "idle_and_admission": "idle demand stays false, zero/expired deadlines fail, contended admission times out or cancels, closed retained State reports SharedChannelClosed"
  },
  "results": {
    "shared_channel_debug": "217/217 passed",
    "public_package_debug": "26/26 passed",
    "independent_matrix": "18 rows passed; three shared_reset modes each complete two RPCs on one retained transport with all sockets retired"
  },
