  "design": {
    "references": [
      "/nav_env/Work/grpc/src/core/ext/transport/chttp2/transport/frame_data.cc",
      "/nav_env/Work/grpc/src/core/call/message.h"
    ],
    "description": "Decoder callbacks can take OwnedDecodedMessage. A message already assembled across DATA calls transfers its exact reassembly allocation to a successful callback. SharedChannel also reuses a direct, uncompressed, nonempty input chunk when the decoded payload reaches the chunk end: it moves the payload to the allocation start and shrinks in place, falling back to an exact duplicate if resize is unavailable.",
    "small_message_boundary": "Direct decoder callbacks remain borrowed. Empty and compressed direct messages retain the previous copy path, and Message keeps the original allocator/slice/bool layout.",
    "failure_contract": "Decoder state relinquishes a completed allocation before callback entry, frees it on callback failure, frees compressed input after bounded decompression, and transfers decompressed output only on callback success. SharedChannel resize failure falls back to duplicate-and-free; duplicate failure retires the call.",
    "tests": [
      "assembled allocation pointer is transferred without a second allocation",
      "owned callback failure frees the transferred payload",
      "gzip output ownership transfers after bounded decompression",
      "direct messages retain the borrowed callback path"
    ],
    "rejected_variants": [
      "All messages owned by the decoder: improved 256 KiB but regressed zero-byte work.",
      "A larger Message storage representation: improved large messages but regressed zero-byte cycles.",
      "A packed storage representation: corrected after a truncation bug, then removed because the original Message layout performs better.",
      "An external runtime pending-payload branch: small-message PMU work moved slightly backward."
    ]
  },
