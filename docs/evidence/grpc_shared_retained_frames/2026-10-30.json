  "design": {
    "reference": "/nav_env/Work/grpc/src/core/lib/slice",
    "description": "Duplex readers retain immutable subspans of the 64 KiB read-ahead allocation through an atomic SharedReadBuffer. The reader reuses a block only as sole owner; otherwise it transactionally rolls the incomplete suffix into a new block before socket input.",
    "compatibility": "Public and ordinary OwnedFrame remains exact-allocation owned and 48 bytes. Internal RetainedFrame is 56 bytes. Ordinary readers transactionally materialize exact ownership when they consume a shared duplex queue entry.",
    "hpack": "When a predecoded queued HEADERS frame crosses from shared to exact storage, its payload identity key is rekeyed before the old block is released so dynamic state is never decoded twice.",
    "failure_contract": "First-owner OOM replays the same complete frame; rollover OOM performs no socket read; ordinary-queue copy OOM does not advance the queue; retained frames may outlive Reader destruction.",
    "layout": {
      "connection_debug_bytes_before": 1872,
      "connection_debug_bytes_after": 2032,
      "owned_frame_bytes": 48,
      "retained_frame_bytes": 56
    },
    "rejected_variants": [
      "Global SharedReadBuffer ownership on every OwnedFrame: zero-byte cycles and timing were neutral-to-negative because the public frame type grew everywhere.",
      "Copy frames below 1 KiB while retaining only large frames: zero-byte instructions, cycles, throughput, p50 and p99 all regressed in 8/8 pairs."
    ]
  },
