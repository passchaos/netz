  "design": {
    "canonical_type": "grpc.DuplexOwnedMessage",
    "shared_alias": "grpc.SharedStreamOwnedWriteMessage",
    "storage_module": "src/grpc/stream/duplex/outbound_ownership.zig",
    "description": "OwnedMessage reserves five prefix bytes and exposes a writable payload. Direct ClientDuplex, ServerDuplex, and SharedStreamWriter can allocate it in their transport allocator and consume it without a payload clone.",
    "client_api": [
      "ClientDuplex.allocMessage",
      "ClientDuplex.writeOwnedMessage",
      "ClientDuplex.writeOwnedMessageWithOptions",
      "ClientDuplex.writeFinalOwnedMessage",
      "ClientDuplex.writeFinalOwnedMessageWithOptions"
    ],
    "server_api": [
      "ServerDuplex.allocMessage",
      "ServerDuplex.writeOwnedMessage",
      "ServerDuplex.writeOwnedMessageWithOptions"
    ],
    "shared_api": "The existing SharedStreamWriter owned methods retain source compatibility through an alias to the generic type.",
    "consumption_contract": "Every write consumes the nullable message on success or error. Deferred deinit remains safe.",
    "compression_contract": "Identity and compression fallback transfer the exact allocation into PendingMessage. Successful compression retains a separate framed allocation and frees the original input after ownership is secure.",
    "failure_contract": "Message-size and writer-state validation occur before allocation or transfer where possible; allocator mismatch is transactional; transport failure discards pending ownership through the existing stream failure path."
  },
