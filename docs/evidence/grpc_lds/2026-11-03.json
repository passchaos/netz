  "feature": "Client LDS/HCM and listener-driven inline/dynamic RDS publication",
  "decision": "accepted",
  "base_head": "46b252a9a459712b3b7c25abe2d3adfd0b5017ad",
  "behavior": {
    "decode": "owned v3 client API Listener/HCM, unique filter names, effective router terminal and optional unknown handling, ADS/SELF AUTO-or-V3 source, max-stream default, bounded storage and nested RDS",
    "inline": "inline RDS validates once and transfers parsed ownership to a snapshot; controller and published projection independently retain route storage",
    "dynamic": "same RDS name reuses cached parsed data and publishes new immutable HCM duration projection, direct source ownership without projection chains; original RPC choice/deadline retained",
    "changes": "new RDS names/modes clear route admission; old-name RDS cannot restore new routing; inline/deleted listener late RDS validates/ACKs without publication; omission installs rejecting routes",
    "transaction": "allocate desired subscription before publication, commit names/cache after successful selector update, then accept ADS version and ACK; validation/alloc/topology/stale/deadline failure preserves prior state",
    "source": "shared ADS/SELF ConfigSource used by CDS and LDS; AUTO follows v3 session, explicit V2/unknown rejected",
    "limits": "client API Listener over existing application cluster manager; bootstrap, automatic CDS/EDS children, failover/expiry/Delta/LRS, non-router filters, server filter chains and full security/rewrites remain open"
  },
