  "feature": "Typed EDS-backed CDS policies, circuit limits and transactional CDS/EDS publication",
  "decision": "accepted",
  "base_head": "54d1546a380127c0707d6539c408478636155ea0",
  "behavior": {
    "decode": "owned bounded EDS-backed v3 Cluster, ADS/self EDS source, exact logical/service identity, first DEFAULT request threshold default1024 and explicit zero",
    "policies": "legacy RR/locality and direct ring; ordered typed unknown fallback, RR/ring/pick_first/least_request/WrrLocality, recognized invalid rejection, depth16 and ordinary ServiceConfig validation",
    "projection": "direct policy leaf selects across localities within priority; checked uint32 locality times endpoint ring weights; stable locality endpoint suffixes preserve transports; shuffle groups by actual leaf prefix",
    "publication": "selected CDS configuration and matching EDS image are owned; prepare subscription allocation before publication, commit names and accepted config/version without allocation after publication, then ACK",
    "updates": "same EDS name reprojects cache under new policy/circuit; changed name immediately removes old endpoint/drop admission and awaits matching assignment; omission removes CDS and late EDS cannot restore it",
    "rollback": "invalid resources/duplicate names/stale tokens/expired deadline/alloc or publication failures retain topology, cached state, desired names and accepted version; ACK failure retains committed version",
    "limits": "one explicitly selected EDS-backed cluster; rejects security/outlier/LRS/upstream config and DNS/aggregate clusters; runtime ring allocation still capped4096; LDS/RDS/bootstrap/failover/expiry/Delta/LRS remain open"
  },
